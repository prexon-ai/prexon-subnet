FROM python:3.12.12-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.11.20 /uv /usr/local/bin/uv
RUN useradd --uid 10001 --create-home prexon
WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY shared ./shared
COPY evaluation/__init__.py ./evaluation/__init__.py
COPY api ./api
COPY validator/__init__.py validator/config.py ./validator/
COPY miner/__init__.py ./miner/__init__.py
# Settings come from validator/config.py (Compose mounts the checkout's copy); its paths
# are anchored to /app, so runtime files live under /app/runtime.
RUN uv sync --frozen --no-dev --extra api \
    && mkdir -p /app/runtime/api /app/runtime/intake-policy \
    && chown -R prexon:prexon /app/runtime
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1
USER prexon
EXPOSE 8080
ENTRYPOINT ["prexon-api"]
CMD ["--host", "0.0.0.0"]
