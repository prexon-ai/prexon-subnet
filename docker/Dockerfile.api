FROM python:3.12.12-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.11.20 /uv /usr/local/bin/uv
RUN useradd --uid 10001 --create-home prexon
WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE ./
COPY shared ./shared
COPY evaluation/__init__.py ./evaluation/__init__.py
COPY api ./api
COPY validator/__init__.py ./validator/__init__.py
COPY miner/__init__.py ./miner/__init__.py
RUN uv sync --frozen --no-dev --extra api \
    && mkdir -p /data/api /data/public/artifacts /data/intake-policy \
    && chown -R prexon:prexon /data
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1 PREXON_API_HOST=0.0.0.0 \
    PREXON_DASHBOARD_PATH=/data/public/dashboard.json \
    PREXON_PUBLIC_ARTIFACT_ROOT=/data/public/artifacts \
    PREXON_UPLOAD_POLICY_PATH=/data/intake-policy/upload-policy.json \
    PREXON_UPLOAD_STATE_PATH=/data/api/uploads.sqlite3
USER prexon
EXPOSE 8000
ENTRYPOINT ["prexon-api"]
