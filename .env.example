# Shared configuration for the validator and API on one machine. Copy to .env.
# Miner commands accept parameters directly; an explicit --env-file is optional.
# Empty IDs disable both targets; the idle controller needs no chain/rental credentials.
PREXON_MODEL_1_ID=
PREXON_MODEL_1_REVISION=
PREXON_MODEL_1_METHODS=dflash2
PREXON_MODEL_1_ALLOCATION=100
PREXON_MODEL_1_PROFILE=profiles/model-1.json
PREXON_MODEL_2_ID=
PREXON_MODEL_2_REVISION=
PREXON_MODEL_2_METHODS=dflash2
PREXON_MODEL_2_ALLOCATION=
PREXON_MODEL_2_PROFILE=profiles/model-2.json
# With two targets, explicitly assign allocations adding to 100, e.g. 20 and 80.

PREXON_STATE_PATH=runtime/validator.sqlite3
PREXON_DATASET_CACHE=runtime/datasets
PREXON_DASHBOARD_PATH=runtime/public/dashboard.json
PREXON_UPLOAD_POLICY_PATH=runtime/intake-policy/upload-policy.json
PREXON_POLL_SECONDS=30
# Start at >=10 ready candidates OR age >=21600s for the oldest unevaluated ready commitment.
# Age comes from chain submission time, with durable first discovery as fallback; retries retain it.
PREXON_SCHEDULE_SECONDS=21600
PREXON_EARLY_QUEUE_DEPTH=10
PREXON_SESSION_SECONDS=14400
PREXON_SESSION_MAX_COST=100
PREXON_PUBLISH_SECONDS=600
PREXON_PROVIDER=lium
# Standalone evaluation backend and run settings are in its JSON profile.
PREXON_CHAIN=bittensor
PREXON_CHAIN_FILE=runtime/chain.json
PREXON_NETWORK=finney
PREXON_NETUID=0
PREXON_BURN_UID=0
PREXON_WEIGHTS_VERSION=1
PREXON_WALLET_NAME=default
PREXON_WALLET_HOTKEY=default
PREXON_WALLET_PATH=~/.bittensor/wallets

# Production Hippius: use THREE DIFFERENT BUCKETS, never public/private sibling prefixes.
# Staging stays private; only its API-issued PUT capabilities go to miners.
PREXON_UPLOAD_STAGING_ROOT=
# PREXON_UPLOAD_STAGING_ROOT=s3://prexon-staging/intake
# Private canonical objects, qualification, jobs and results (default runtime/artifacts).
# PREXON_ARTIFACT_ROOT=s3://prexon-private/artifacts
# Only verified winners are copied here (default runtime/public/artifacts).
# PREXON_PUBLIC_ARTIFACT_ROOT=s3://prexon-winners
# Stable public HTTPS base, including the public root's prefix if configured.
# Hippius uses path-style public URLs, so include the winner bucket name.
PREXON_PUBLIC_ARTIFACT_BASE_URL=
# PREXON_PUBLIC_ARTIFACT_BASE_URL=https://s3.hippius.com/prexon-winners

# Validator credentials may read staging and operate private canonical/public-winner storage.
# Create S3 credentials/sub-tokens in https://console.hippius.com; keep private buckets private.
# The trusted API and validator share this storage configuration; miners need no S3 keys.
S3_ENDPOINT_URL=https://s3.hippius.com
S3_REGION=decentralized
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=

# API settings. Both services read this .env and share the paths above.
PREXON_API_HOST=127.0.0.1
PREXON_API_PORT=8000
PREXON_UPLOADS_ENABLED=false
# API-owned durable nonce/quota state, separate from validator queue/award state.
PREXON_UPLOAD_STATE_PATH=runtime/api/uploads.sqlite3
PREXON_UPLOAD_POLICY_MAX_AGE_SECONDS=300
PREXON_UPLOAD_URL_TTL_SECONDS=900
PREXON_UPLOAD_REQUEST_MAX_AGE_SECONDS=60
PREXON_UPLOAD_MAX_REQUESTS_PER_HOUR=4
PREXON_UPLOAD_MAX_BYTES=4297064448
# Controller rental credentials. Compose passes only API/storage settings to the API.
LIUM_API_KEY=
PREXON_LIUM_BASE_URL=https://lium.io/api
PREXON_LIUM_TEMPLATE_ID=
PREXON_LIUM_VOLUME_ID=
PREXON_SSH_PRIVATE_KEY=~/.ssh/id_ed25519
PREXON_SSH_PUBLIC_KEY=~/.ssh/id_ed25519.pub
PREXON_SSH_KNOWN_HOSTS=runtime/known_hosts
