# Copy to .env and fill in the sections this machine uses. Every other setting is in
# validator/config.py and evaluation/config.py.

# Validator: the owner's server (validator and upload API) -----------------------------
# Network: finney (mainnet) or test (testnet). The netuid is required before targets
# are enabled.
PREXON_NETWORK=finney
PREXON_NETUID=
# The hotkey that signs weights.
PREXON_WALLET_NAME=default
PREXON_WALLET_HOTKEY=default
PREXON_WALLET_PATH=~/.bittensor/wallets
# One Hippius S3 key covering the uploads, private and public buckets
# (https://console.hippius.com).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Evaluation: GPU rentals for the validator and for prexon-evaluate (miners too) ---------
LIUM_API_KEY=
LIUM_TEMPLATE_ID=
# Each competition's volume (mounted at /mnt), as MODEL_ID=VOLUME_ID pairs separated by
# commas, for example Qwen/Qwen3.8-27B=your-volume-id. Optional.
LIUM_VOLUMES=
SSH_PRIVATE_KEY=~/.ssh/id_ed25519
SSH_PUBLIC_KEY=~/.ssh/id_ed25519.pub
